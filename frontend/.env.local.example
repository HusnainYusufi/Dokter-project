NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-me-to-a-random-32-char-string
ADMIN_EMAIL=admin@hospital.com
ADMIN_PASSWORD=changeme
# Preferred for production:
# ADMIN_PASSWORD_HASH=scrypt$base64salt$base64hash
NEXT_PUBLIC_API_URL=http://localhost:8000

# Dropbox import from server-side env only.
# Use either direct access token:
# DROPBOX_ACCESS_TOKEN=
#
# Or refresh-token flow:
# DROPBOX_REFRESH_TOKEN=
# DROPBOX_APP_KEY=
# DROPBOX_APP_SECRET=
#
# Demo: block new uploads/imports while any job is queued or processing (default off).
# NEXT_PUBLIC_DEMO_MODE=true
