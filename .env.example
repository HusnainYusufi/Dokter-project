# ── FastAPI ────────────────────────────────────────────────
LLAMA_CLOUD_API_KEY=your_llama_cloud_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
AI_PROVIDER=openai
OPENAI_PAGE_MODEL=gpt-5.2
OPENAI_BUNDLE_MODEL=gpt-5.4
GEMINI_PAGE_MODEL=gemini-2.5-flash
GEMINI_BUNDLE_MODEL=gemini-2.5-flash
# 1 = every page parsed in isolation (no cross-page content bleed within a call).
# 300 DPI is the OCR sweet spot; 600 is rarely better and far costlier.
OPENAI_PAGE_RENDER_DPI=300
# original | high | auto | low. Use "original" for handwriting/poor scans so the
# model keeps full resolution; "high" downsamples (makes higher DPI pointless).
OPENAI_PAGE_IMAGE_DETAIL=original
AI_PAGE_CONCURRENCY=3
EXTRACTION_MODE=MULTIMODAL
SUMMARY_MODE=FAST
# Comma-separated origins, no trailing slashes.
CORS_ALLOW_ORIGINS=http://localhost:3000,https://frontend-production-fb7e.up.railway.app
DATABASE_URL=mysql+pymysql://medicalai:medicalai@mysql:3306/medical_ai_bot
LEGACY_JOB_STORAGE_DIR=storage/jobs
JOB_RETENTION_HOURS=72
# Recommended: set this before changing AI providers, so stored jobs remain decryptable.
ARTIFACT_ENCRYPTION_KEY=
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET_NAME=medical-ai-vault
S3_REGION=us-east-1
S3_USE_SSL=false
ALLOW_LOCAL_FALLBACK=false
ENABLE_LEGACY_JOB_IMPORT=true
# Optional shared secret for /api/v1. Leave empty (the default) and the API
# accepts any caller that can reach it, as before.
# Set it to require "Authorization: Bearer <token>" on every /api/v1 request.
# IMPORTANT: the portal calls the API from the browser, so it can only send a
# token that is compiled into the client bundle (NEXT_PUBLIC_API_AUTH_TOKEN
# below) and is therefore readable by anyone who loads the portal. Treat this
# as a guard against unauthenticated scanning and stray direct calls, NOT as a
# replacement for keeping the API off the public network. For real isolation,
# expose only nginx and leave the API unpublished.
API_AUTH_TOKEN=

# ── Next.js / NextAuth ─────────────────────────────────────
# Set to your public domain (no trailing slash)
NEXTAUTH_URL=https://medaibot.aitoolsofficial.com
NEXTAUTH_SECRET=replace-with-random-32-char-string
ADMIN_EMAIL=admin@hospital.com
ADMIN_PASSWORD=changeme
# Must match API_AUTH_TOKEN when that is set. Baked into the client bundle at
# build time and visible to anyone who loads the portal - see the note above.
NEXT_PUBLIC_API_AUTH_TOKEN=
# Preferred for production auth hardening:
# ADMIN_PASSWORD_HASH=scrypt$base64salt$base64hash

