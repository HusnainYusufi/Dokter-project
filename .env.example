# ── FastAPI ────────────────────────────────────────────────
LLAMA_CLOUD_API_KEY=your_llama_cloud_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
AI_PROVIDER=openai
OPENAI_PAGE_MODEL=gpt-4.1
OPENAI_BUNDLE_MODEL=gpt-5.4
GEMINI_PAGE_MODEL=gemini-2.5-flash
GEMINI_BUNDLE_MODEL=gemini-2.5-flash
OPENAI_PAGE_BATCH_SIZE=2
OPENAI_PAGE_RENDER_DPI=200
AI_PAGE_CONCURRENCY=3
EXTRACTION_MODE=MULTIMODAL
SUMMARY_MODE=FAST
# Comma-separated origins, no trailing slashes.
CORS_ALLOW_ORIGINS=http://localhost:3000,https://frontend-production-fb7e.up.railway.app
DATABASE_URL=mysql+pymysql://medicalai:medicalai@mysql:3306/medical_ai_bot
LEGACY_JOB_STORAGE_DIR=storage/jobs
JOB_RETENTION_HOURS=72
# Recommended: set this before changing AI providers, so stored jobs remain decryptable.
ARTIFACT_ENCRYPTION_KEY=
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET_NAME=medical-ai-vault
S3_REGION=us-east-1
S3_USE_SSL=false
ALLOW_LOCAL_FALLBACK=false
ENABLE_LEGACY_JOB_IMPORT=true

# ── Next.js / NextAuth ─────────────────────────────────────
# Set to your public domain (no trailing slash)
NEXTAUTH_URL=https://medaibot.aitoolsofficial.com
NEXTAUTH_SECRET=replace-with-random-32-char-string
ADMIN_EMAIL=admin@hospital.com
ADMIN_PASSWORD=changeme
# Preferred for production auth hardening:
# ADMIN_PASSWORD_HASH=scrypt$base64salt$base64hash

